# Copy to .env and fill in. .env is gitignored; this file is the documented
# shape (design section 9). Every variable the gateway reads is listed here
# with the phase that introduces it, so nothing is configured by surprise.

# --- Database (phase 2) -----------------------------------------------------
# SQLAlchemy URL for the event ledger and dead-letter store. The default
# matches docker-compose.yml.
DATABASE_URL=postgresql+psycopg://gateway:gateway@localhost:5432/gateway

# --- Ingest API (phase 3) ---------------------------------------------------
# Shared secrets for HMAC-SHA256 webhook signature verification, one per CRM
# source. Generate with: openssl rand -hex 32
WEBHOOK_SECRET_SALESFORCE=
WEBHOOK_SECRET_HUBSPOT=
# Reject a webhook whose timestamp header is further than this from now.
# Bounds the replay window; keep small but tolerant of clock skew.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# --- Queue and worker (phase 3) --------------------------------------------
# "pubsub" (Google Cloud Pub/Sub; the emulator locally) or "memory" (single
# process only; tests and demos).
QUEUE_BACKEND=pubsub
PUBSUB_PROJECT_ID=local-project
PUBSUB_TOPIC=lead-events
PUBSUB_SUBSCRIPTION=lead-events-processor
# Read directly by the google-cloud-pubsub client. Set it to talk to the
# emulator from docker-compose.yml; leave it unset for the real service.
PUBSUB_EMULATOR_HOST=localhost:8085
# Messages pulled per worker iteration, and how long a pull waits when idle.
WORKER_BATCH_SIZE=10
WORKER_POLL_TIMEOUT_SECONDS=5
# `gateway reconcile` reports QUEUED events older than this as stuck.
RECONCILE_STUCK_AFTER_SECONDS=300

# --- Upload batching (phase 4) ---------------------------------------------
# How many conversions to send per upload request, and how long to wait for
# a batch to fill before sending a partial one.
UPLOAD_BATCH_SIZE=100
UPLOAD_BATCH_WAIT_SECONDS=5

# --- Upload client (phase 4) ------------------------------------------------
# Base URL of the ad platform's offline conversion endpoint. Points at the
# mock server in local development.
ADS_API_BASE_URL=http://localhost:8081
ADS_API_TOKEN=
ADS_API_TIMEOUT_SECONDS=10
# Retry policy for transient failures: exponential backoff with full jitter,
# bounded by both attempt count and total elapsed time (design section 7).
UPLOAD_MAX_ATTEMPTS=6
UPLOAD_MAX_ELAPSED_SECONDS=600

# --- Observability (phase 6) ------------------------------------------------
LOG_LEVEL=INFO
# Port the Prometheus /metrics endpoint listens on.
METRICS_PORT=9090
